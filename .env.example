# Point the SPA at the backend. Unset (or absent) = the original localStorage prototype.
#
# This flag is the REVERT MECHANISM for the API wiring: there is no version control on this
# project, so being able to fall back to a known-good prototype by configuration is the only
# rollback available. Do not remove it until the repo is under git and the API path is trusted.
VITE_API_URL=http://localhost:4000
